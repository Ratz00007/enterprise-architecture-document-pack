# syntax=docker/dockerfile:1.7
# Multi-stage build for the claims-web.
# Final image is a distroless nginx serving the static bundle.

# ---- build stage ---------------------------------------------------------
FROM node:20-bookworm-slim AS build
WORKDIR /workspace
RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json vite.config.ts index.html ./
COPY src src
COPY public public
RUN pnpm build

# ---- runtime stage -------------------------------------------------------
FROM gcr.io/distroless/nginx-debian12:nonroot
COPY --from=build /workspace/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
USER nonroot
ENTRYPOINT ["/usr/bin/nginx","-c","/etc/nginx/nginx.conf","-g","daemon off;"]
